}
* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); }
button, summary, textarea { font: inherit; }
.shell { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
header { padding: 40px 0 22px; }
.header-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.header-top .eyebrow { margin: 0; }
.eyebrow { margin: 0 0 6px; color: var(--brand); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.2rem); letter-spacing: -0.045em; }
.subtitle { margin: 10px 0 0; color: var(--muted); }
.toolbar { display: flex; gap: 8px; flex-wrap: wrap; }
.button { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 9px; background: var(--panel); color: var(--ink); cursor: pointer; font-weight: 750; }
.button:hover { border-color: var(--brand); color: var(--brand); }
.button:focus-visible, .choice:focus-visible, .more:focus-visible, .chip:focus-visible { outline: 3px solid var(--brand-soft); outline-offset: 2px; }
.button.primary { background: var(--ink); border-color: var(--ink); color: var(--panel); }
.button.primary:hover { background: var(--brand); border-color: var(--brand); color: white; }
.button[hidden], .js-only[hidden] { display: none; }
.hud { position: sticky; top: 0; z-index: 10; display: grid; gap: 10px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; background: var(--bar); box-shadow: 0 12px 32px var(--shadow); backdrop-filter: blur(12px); }
.hud-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.progress { font-weight: 800; }
.progress small { color: var(--muted); font-weight: 600; }
.bar { flex: 1 1 160px; height: 8px; border-radius: 999px; background: var(--code); overflow: hidden; }
.bar span { display: block; height: 100%; width: 0; background: var(--brand); transition: width 0.2s; }
.save-status { color: var(--muted); font-size: 0.84rem; }
.chips { display: flex; gap: 6px; flex-wrap: wrap; }
.chips .label { align-self: center; color: var(--muted); font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; margin-right: 2px; }
.chip { padding: 6px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--muted); cursor: pointer; font-size: 0.84rem; font-weight: 750; white-space: nowrap; }
.chip.active { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
.chip b { color: var(--ink); }
.keys { color: var(--muted); font-size: 0.8rem; }
.keys kbd { padding: 1px 5px; border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; background: var(--panel); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.78rem; }
main { padding: 22px 0 60px; }
h2 { margin: 34px 0 6px; font-size: 1.5rem; letter-spacing: -0.03em; }
h2 .tag { margin-left: 8px; color: var(--muted); font-size: 0.85rem; font-weight: 700; letter-spacing: 0; vertical-align: middle; }
.section-lead { margin: 0 0 14px; color: var(--muted); }
.section[hidden] { display: none; }
.notice, .empty { margin: 14px 0; padding: 17px 19px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
.notice h3 { margin: 0 0 8px; font-size: 1rem; }
.notice ul { margin: 0; padding-left: 20px; }
.notice li { line-height: 1.5; }
.notice .tag { color: var(--muted); font-size: 0.8rem; font-weight: 700; margin-right: 6px; }
.notice.error { border-color: var(--danger-line); background: var(--danger-soft); }
.notice.warning { border-color: var(--warning-line); background: var(--warning-soft); }
.empty { display: flex; gap: 10px; color: var(--safe); }
.item { margin: 10px 0; border: 1px solid var(--line); border-radius: 13px; background: var(--panel); }
.item[hidden] { display: none; }
.item:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
.item[data-decision="upgrade"] { border-left: 5px solid var(--safe); }
.item[data-decision="skip"] { border-left: 5px solid var(--muted); opacity: 0.72; }
.item[data-decision="defer"] { border-left: 5px solid var(--warning); }
.row { display: grid; grid-template-columns: auto minmax(160px, 1.3fr) minmax(170px, 1fr) auto auto; grid-template-areas: "decide who versions action more" "decide summary summary summary flag"; gap: 4px 16px; align-items: center; padding: 14px 18px; }
.decide { grid-area: decide; display: inline-flex; border: 1px solid var(--line); border-radius: 9px; overflow: hidden; }
.choice { padding: 7px 11px; border: 0; border-right: 1px solid var(--line); background: var(--panel); color: var(--muted); cursor: pointer; font-size: 0.82rem; font-weight: 800; }
.choice:last-child { border-right: 0; }
.choice:hover { color: var(--ink); background: var(--code); }
.choice.upgrade.active { background: var(--safe); color: white; }
.choice.skip.active { background: var(--muted); color: white; }
.choice.defer.active { background: var(--warning); color: white; }
.who { grid-area: who; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.name { font-weight: 800; font-size: 1.02rem; }
.group { color: var(--muted); font-size: 0.84rem; }
.versions { grid-area: versions; color: var(--muted); font-variant-numeric: tabular-nums; }
.versions .target { color: var(--ink); }
.versions .latest { margin-left: 6px; font-size: 0.8rem; }
.action { grid-area: action; justify-self: start; padding: 5px 9px; border-radius: 999px; font-size: 0.72rem; font-weight: 850; text-transform: uppercase; }
.action.migrate { background: var(--danger-soft); color: var(--danger); }
.action.hold { background: var(--warning-soft); color: var(--warning); }
.action.decide { background: var(--decide-soft); color: var(--decide); }
.action.upgrade { background: var(--safe-soft); color: var(--safe); }
.more { grid-area: more; padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px; background: transparent; color: var(--muted); cursor: pointer; font-size: 0.82rem; font-weight: 750; }
.more:hover, .more[aria-expanded="true"] { border-color: var(--brand); color: var(--brand); }
.summary { grid-area: summary; margin: 2px 0 0; line-height: 1.5; }
.note-flag { grid-area: flag; justify-self: end; color: var(--brand); font-size: 0.74rem; font-weight: 800; text-transform: uppercase; }
.note-flag[hidden] { display: none; }
.details { padding: 4px 22px 20px; border-top: 1px solid var(--line); }
.details[hidden] { display: none; }
.columns { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
.details h4 { margin: 18px 0 6px; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
.details p, .details li { line-height: 1.55; margin: 4px 0; }
.details ul, .details ol { margin: 0; padding-left: 20px; }
.release-link { display: inline-block; margin-top: 6px; color: var(--brand); font-weight: 750; }
code { padding: 2px 5px; border-radius: 5px; background: var(--code); font-size: 0.84em; }
.note-field { display: block; margin-top: 18px; }
.note-field span { display: block; margin-bottom: 6px; font-size: 0.82rem; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
.note { width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; background: var(--paper); color: var(--ink); resize: vertical; }
.note:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
.notes { margin: 14px 0; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
.notes summary { padding: 14px 18px; cursor: pointer; font-weight: 750; }
.notes ul { margin: 0; padding: 0 18px 16px 38px; }
.notes li { line-height: 1.5; margin: 4px 0; color: var(--muted); font-size: 0.92rem; }
.muted, footer { color: var(--muted); }
footer { padding: 0 0 40px; font-size: 0.84rem; }
.toast { position: fixed; left: 50%; bottom: 24px; z-index: 20; transform: translateX(-50%); padding: 12px 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--ink); color: var(--panel); box-shadow: 0 12px 32px var(--shadow); font-weight: 700; }
.toast[hidden] { display: none; }
dialog { width: min(760px, calc(100% - 32px)); padding: 20px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); color: var(--ink); }
dialog::backdrop { background: rgb(23 32 51 / 40%); }
dialog textarea { width: 100%; min-height: 50vh; margin: 12px 0; padding: 10px; border: 1px solid var(--line); border-radius: 9px; background: var(--paper); color: var(--ink); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.84rem; }
@media screen {
  :root[data-theme="dark"] {
    color-scheme: dark;
    --ink: #e7edf8;
    --muted: #a7b1c4;
    --paper: #0e1422;
    --panel: #171f30;
    --line: #34405a;
    --bar: rgb(23 31 48 / 94%);
    --shadow: rgb(0 0 0 / 25%);
    --code: #232d42;
    --brand: #93adff;
    --brand-soft: #24345e;
    --danger: #ffaaa3;
    --danger-soft: #3b2025;
    --danger-line: #744047;
    --warning: #ffd576;
    --warning-soft: #3a2f17;
    --warning-line: #6f5b2d;
    --decide: #d1bbff;
    --decide-soft: #2f2546;
    --decide-line: #5e4a83;
    --safe: #86d9af;
    --safe-soft: #17382a;
    --safe-line: #2d5a44;
  }
  :root[data-theme="dark"] .choice.upgrade.active, :root[data-theme="dark"] .choice.defer.active { color: #0e1422; }
}
@media (max-width: 820px) {
  .shell { width: min(100% - 20px, 1180px); }
  header { padding-top: 26px; }
  .row { grid-template-columns: 1fr auto; grid-template-areas: "who action" "versions more" "summary summary" "decide flag"; }
  .decide { justify-self: start; margin-top: 6px; }
  .columns { grid-template-columns: 1fr; gap: 0; }
}
@media print {
  body { background: white; }
  .shell { width: 100%; }
  .hud, .toolbar, .decide, .more, .note-field, footer, .toast, dialog { display: none !important; }
  .item, .item[hidden], .section[hidden] { display: block !important; break-inside: avoid; opacity: 1; }
  .details, .details[hidden] { display: block !important; }
  .notes[open] summary { font-weight: 800; }
  a { color: inherit; }
}
