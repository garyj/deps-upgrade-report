<body>
  <header class="shell">
    <div class="header-top">
      <p class="eyebrow">Dependency upgrade plan</p>
      <div class="toolbar js-only" hidden>
        <button class="button" type="button" data-copy>Copy plan</button>
        <button class="button" type="button" data-export>Export plan</button>
        <button class="button primary" type="button" data-finish hidden>Finish review</button>
        <button class="button" type="button" data-theme-toggle>Toggle theme</button>
      </div>
    </div>
    <h1>{{ project_name }}</h1>
    <p class="subtitle">Generated {{ generated }} from {{ project_root }}</p>
  </header>
  <main class="shell" data-report-id="{{ report_id }}">
    <div class="hud">
      <div class="hud-row">
        <span class="progress"><b data-decided>0</b> of {{ overview.outdated }} decided <small data-summary></small></span>
        <div class="bar"><span data-bar></span></div>
        <span class="save-status" data-save-status></span>
      </div>
      <div class="hud-row">
        <div class="chips" data-filter-group="action">
          <span class="label">Show</span>
          <button type="button" class="chip active" data-filter="all">All <b>{{ overview.outdated }}</b></button>
          <button type="button" class="chip" data-filter="decide">Decide <b>{{ overview.decide }}</b></button>
          <button type="button" class="chip" data-filter="migrate">Migrate <b>{{ overview.migrate }}</b></button>
          <button type="button" class="chip" data-filter="hold">Hold <b>{{ overview.hold }}</b></button>
          <button type="button" class="chip" data-filter="upgrade">Upgrade <b>{{ overview.upgrade }}</b></button>
        </div>
        <div class="chips" data-filter-group="decision">
          <span class="label">Decision</span>
          <button type="button" class="chip active" data-filter="all">Any</button>
          <button type="button" class="chip" data-filter="">Undecided</button>
          <button type="button" class="chip" data-filter="upgrade">Upgrade</button>
          <button type="button" class="chip" data-filter="skip">Skip</button>
          <button type="button" class="chip" data-filter="defer">Defer</button>
        </div>
        <span class="keys js-only" hidden><kbd>j</kbd>/<kbd>k</kbd> move · <kbd>u</kbd> upgrade · <kbd>s</kbd> skip · <kbd>d</kbd> defer · <kbd>o</kbd> details · <kbd>n</kbd> note</span>
      </div>
    </div>

    {% set blockers = [] %}
    {% for fragment in fragments %}{% for blocker in fragment.blockers %}{% set _ = blockers.append((fragment.label, blocker)) %}{% endfor %}{% endfor %}
    {% set errors = [] %}
    {% for fragment in fragments %}{% for error in fragment.errors %}{% set _ = errors.append((fragment.label, error)) %}{% endfor %}{% endfor %}
    {% if errors %}
    <section class="notice error">
      <h3>Incomplete research</h3>
      <ul>{% for label, error in errors %}<li><span class="tag">{{ label }}</span>{{ error }}</li>{% endfor %}</ul>
    </section>
    {% endif %}
    {% if blockers %}
    <section class="notice warning">
      <h3>Check before you start</h3>
      <ul>{% for label, blocker in blockers %}<li><span class="tag">{{ label }}</span>{{ blocker }}</li>{% endfor %}</ul>
    </section>
    {% endif %}

    {% set batch_number = namespace(value=0) %}
    {% for fragment in fragments %}
      {% for batch in fragment.batches %}
      {% set batch_number.value = batch_number.value + 1 %}
      <section class="section" data-section>
        <h2>Batch {{ batch_number.value }}: {{ batch.name }}<span class="tag">{{ fragment.label }}</span></h2>
        <p class="section-lead">{{ batch.reason }}</p>
        {% for entry in batch.entries %}{{ item(entry, fragment) }}{% endfor %}
      </section>
      {% endfor %}
    {% endfor %}

    {% for fragment in fragments %}
    <section class="section" data-section>
      <h2>{{ fragment.label }}<span class="tag">{{ fragment.manager }} · {{ fragment.remaining|length }} of {{ fragment.entries|length }} outside batches</span></h2>
      {% for entry in fragment.remaining %}
        {{ item(entry, fragment) }}
      {% else %}
        {% if not fragment.entries and not fragment.errors %}
        <div class="empty"><strong>Current</strong><span>No outdated direct dependencies found.</span></div>
        {% elif fragment.entries %}
        <p class="section-lead">Every {{ fragment.label }} entry belongs to a batch above.</p>
        {% endif %}
      {% endfor %}
    </section>
    {% endfor %}

    {% for fragment in fragments if fragment.notes %}
    <details class="notes">
      <summary>{{ fragment.label }} research notes ({{ fragment.notes|length }})</summary>
      <ul>{% for note in fragment.notes %}<li>{{ note }}</li>{% endfor %}</ul>
    </details>
    {% endfor %}
  </main>
  <footer class="shell">Read-only report. No manifests, lockfiles, dependencies, or workflows were changed. Decisions made here are saved for the executing agent; they change nothing in the project.</footer>
  <div class="toast" data-toast hidden></div>
  <dialog data-plan-dialog>
    <p><strong>Copy the plan</strong> and paste it to Claude or Codex.</p>
    <textarea readonly></textarea>
    <button class="button" type="button" data-close-dialog>Close</button>
  </dialog>
  <script id="plan-data" type="application/json">{{ plan|tojson }}</script>
  <script>
const plan = JSON.parse(document.getElementById('plan-data').textContent);
const main = document.querySelector('main');
const items = [...document.querySelectorAll('.item')];
const byId = new Map(items.map(item => [item.dataset.id, item]));
const serverMode = location.protocol === 'http:' || location.protocol === 'https:';
const storageKey = `deps-review:${plan.report_id}`;
const state = { report_id: plan.report_id, decisions: {} };
let serverAvailable = false;
let serverStateFile = 'the review server';
let saveTimer = null;
let finished = false;

document.querySelectorAll('.js-only').forEach(node => { node.hidden = false; });

const themeToggle = document.querySelector('[data-theme-toggle]');
function syncThemeToggle() {
  const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  themeToggle.textContent = `${nextTheme[0].toUpperCase()}${nextTheme.slice(1)} mode`;
  themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
}
themeToggle.addEventListener('click', () => {
  const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  reportTheme.apply(nextTheme);
  reportTheme.save(nextTheme);
  syncThemeToggle();
});
reportTheme.media.addEventListener('change', event => {
  if (reportTheme.read() !== null) return;
  reportTheme.apply(event.matches ? 'dark' : 'light');
  syncThemeToggle();
});
syncThemeToggle();

const toast = document.querySelector('[data-toast]');
let toastTimer = null;
function showToast(message, sticky = false) {
  toast.textContent = message;
  toast.hidden = false;
  clearTimeout(toastTimer);
  if (!sticky) toastTimer = setTimeout(() => { toast.hidden = true; }, 3200);
}

function setSaveStatus(text) {
  document.querySelector('[data-save-status]').textContent = text;
}

function readLocal() {
  try {
    const raw = localStorage.getItem(storageKey);
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    return parsed && parsed.report_id === plan.report_id && parsed.decisions ? parsed : null;
  } catch {
    return null;
  }
}

function writeLocal() {
  try {
    localStorage.setItem(storageKey, JSON.stringify(state));
  } catch {
    return;
  }
}

async function readServer() {
  const response = await fetch('/api/state', { cache: 'no-store' });
  if (!response.ok) throw new Error(`state ${response.status}`);
  const parsed = await response.json();
  if (parsed && parsed.state_file) serverStateFile = parsed.state_file;
  return parsed && parsed.report_id === plan.report_id && parsed.decisions ? parsed : { report_id: plan.report_id, decisions: {} };
}

async function writeServer() {
  const response = await fetch('/api/state', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(state),
  });
  if (!response.ok) throw new Error(`save ${response.status}`);
}

function persist() {
  writeLocal();
  if (!serverAvailable) {
    setSaveStatus('Saved in this browser');
    return;
  }
  setSaveStatus('Saving…');
  clearTimeout(saveTimer);
  saveTimer = setTimeout(() => {
    writeServer()
      .then(() => setSaveStatus(`Saved to ${serverStateFile}`))
      .catch(() => setSaveStatus('Server unavailable, saved in this browser only'));
  }, 250);
}

function decisionOf(id) {
  return state.decisions[id] || { decision: '', note: '' };
}

function setDecision(id, decision) {
  const current = decisionOf(id);
  const next = current.decision === decision ? '' : decision;
  state.decisions[id] = { decision: next, note: current.note };
  if (!next && !current.note) delete state.decisions[id];
  renderItem(id);
  renderProgress();
  applyFilters();
  persist();
}

function setNote(id, note) {
  const current = decisionOf(id);
  state.decisions[id] = { decision: current.decision, note };
  if (!current.decision && !note.trim()) delete state.decisions[id];
  renderItem(id, false);
  persist();
}

function renderItem(id, syncNote = true) {
  const item = byId.get(id);
  const entry = decisionOf(id);
  item.dataset.decision = entry.decision;
  item.querySelectorAll('.choice').forEach(button => {
    button.classList.toggle('active', button.dataset.decide === entry.decision);
    button.setAttribute('aria-pressed', String(button.dataset.decide === entry.decision));
  });
  item.querySelector('.note-flag').hidden = !entry.note.trim();
  if (syncNote) item.querySelector('.note').value = entry.note;
}

function renderProgress() {
  const counts = { upgrade: 0, skip: 0, defer: 0 };
  for (const item of items) {
    const decision = decisionOf(item.dataset.id).decision;
    if (decision) counts[decision] += 1;
  }
  const decided = counts.upgrade + counts.skip + counts.defer;
  document.querySelector('[data-decided]').textContent = String(decided);
  document.querySelector('[data-summary]').textContent = decided
    ? `(${counts.upgrade} upgrade, ${counts.skip} skip, ${counts.defer} defer)`
    : '';
  document.querySelector('[data-bar]').style.width = `${items.length ? (decided / items.length) * 100 : 0}%`;
}

const filters = { action: 'all', decision: 'all' };
function applyFilters() {
  for (const item of items) {
    const decision = decisionOf(item.dataset.id).decision;
    const actionMatch = filters.action === 'all' || item.dataset.action === filters.action;
    const decisionMatch = filters.decision === 'all' || decision === filters.decision;
    item.hidden = !(actionMatch && decisionMatch);
  }
  document.querySelectorAll('[data-section]').forEach(section => {
    const rows = [...section.querySelectorAll('.item')];
    section.hidden = rows.length > 0 && rows.every(row => row.hidden);
  });
}

document.querySelectorAll('[data-filter-group]').forEach(group => {
  const name = group.dataset.filterGroup;
  const chips = [...group.querySelectorAll('.chip')];
  chips.forEach(chip => chip.addEventListener('click', () => {
    filters[name] = chip.dataset.filter;
    chips.forEach(other => other.classList.toggle('active', other === chip));
    applyFilters();
  }));
});

function toggleDetails(item, open) {
  const button = item.querySelector('.more');
  const details = item.querySelector('.details');
  const next = open === undefined ? details.hidden : open;
  details.hidden = !next;
  button.setAttribute('aria-expanded', String(next));
}

for (const item of items) {
  const id = item.dataset.id;
  item.querySelectorAll('.choice').forEach(button => {
    button.addEventListener('click', event => {
      event.stopPropagation();
      setDecision(id, button.dataset.decide);
    });
  });
  item.querySelector('.more').addEventListener('click', event => {
    event.stopPropagation();
    toggleDetails(item);
  });
  item.querySelector('.note').addEventListener('input', event => setNote(id, event.target.value));
}

function visibleItems() {
  return items.filter(item => !item.hidden);
}

function focusedItem() {
  const active = document.activeElement;
  return active ? active.closest('.item') : null;
}

function moveFocus(direction) {
  const visible = visibleItems();
  if (!visible.length) return;
  const current = focusedItem();
  const index = current ? visible.indexOf(current) : -1;
  const next = visible[Math.min(visible.length - 1, Math.max(0, index + direction))] || visible[0];
  next.focus({ preventScroll: true });
  next.scrollIntoView({ block: 'center', behavior: 'smooth' });
}

document.addEventListener('keydown', event => {
  const target = event.target;
  const typing = target instanceof HTMLTextAreaElement || target instanceof HTMLInputElement;
  if (typing) {
    if (event.key === 'Escape') target.closest('.item')?.focus();
    return;
  }
  if (event.metaKey || event.ctrlKey || event.altKey) return;
  const item = focusedItem();
  switch (event.key) {
    case 'j': event.preventDefault(); moveFocus(1); break;
    case 'k': event.preventDefault(); moveFocus(-1); break;
    case 'u': if (item) setDecision(item.dataset.id, 'upgrade'); break;
    case 's': if (item) setDecision(item.dataset.id, 'skip'); break;
    case 'd': if (item) setDecision(item.dataset.id, 'defer'); break;
    case 'o': case 'Enter': if (item) { event.preventDefault(); toggleDetails(item); } break;
    case 'n': if (item) { event.preventDefault(); toggleDetails(item, true); item.querySelector('.note').focus(); } break;
    default: return;
  }
});

function describe(id) {
  const entry = plan.items[id];
  return `${entry.name} ${entry.current} -> ${entry.target}`;
}

function itemBlock(id, decided) {
  const entry = plan.items[id];
  const note = decisionOf(id).note.trim();
  const lines = [`- ${decided ? '[ ] ' : ''}${describe(id)} (${entry.action}, ${entry.surface_label})`];
  if (note) lines.push(`  - Note: ${note}`);
  if (decided) {
    if (entry.steps.length) {
      lines.push('  - Steps:');
      entry.steps.forEach((step, index) => lines.push(`    ${index + 1}. ${step}`));
    }
    if (entry.verify.length) {
      lines.push('  - Verify:');
      entry.verify.forEach(check => lines.push(`    - ${check}`));
    }
    if (entry.changelog_url) lines.push(`  - Release notes: ${entry.changelog_url}`);
  }
  return lines.join('\n');
}

function buildMarkdown() {
  const counts = { upgrade: [], skip: [], defer: [], undecided: [] };
  for (const item of items) {
    const decision = decisionOf(item.dataset.id).decision;
    counts[decision || 'undecided'].push(item.dataset.id);
  }
  const out = [];
  out.push(`# Dependency upgrade plan: ${plan.project_name}`);
  out.push('');
  out.push(`Source: DEPS_UPGRADE_REPORT.html generated ${plan.generated} for ${plan.project_root}.`);
  out.push(`Decisions: ${counts.upgrade.length} upgrade, ${counts.skip.length} skip, ${counts.defer.length} defer, ${counts.undecided.length} undecided.`);
  out.push('');
  out.push('## Instructions for the executing agent');
  out.push('');
  out.push('- Apply the batches in order, then the remaining items. Finish a batch before starting the next.');
  out.push('- Run each item\'s verification before moving on. Stop and report at the first failure.');
  out.push('- Commands were proposed by the report, not executed. Check them against the project\'s own tooling first.');
  out.push('- Use the project\'s package manager for manifests and lockfiles; do not hand-edit lockfiles.');
  out.push('- Leave skipped, deferred, and undecided packages untouched.');
  for (const batch of plan.batches) {
    const go = batch.ids.filter(id => decisionOf(id).decision === 'upgrade');
    const held = batch.ids.filter(id => decisionOf(id).decision !== 'upgrade');
    if (!go.length) continue;
    out.push('');
    out.push(`## Batch ${batch.number}: ${batch.name} (${batch.surface_label})`);
    out.push('');
    out.push(`Reason: ${batch.reason}`);
    if (held.length) out.push(`Not in this run: ${held.map(id => `${plan.items[id].name} (${decisionOf(id).decision || 'undecided'})`).join(', ')}.`);
    out.push('');
    go.forEach(id => out.push(itemBlock(id, true)));
  }
  for (const section of plan.sections) {
    const go = section.ids.filter(id => decisionOf(id).decision === 'upgrade');
    if (!go.length) continue;
    out.push('');
    out.push(`## ${section.label}`);
    out.push('');
    go.forEach(id => out.push(itemBlock(id, true)));
  }
  for (const [key, title] of [['skip', 'Skipped'], ['defer', 'Deferred'], ['undecided', 'Undecided']]) {
    if (!counts[key].length) continue;
    out.push('');
    out.push(`## ${title}`);
    out.push('');
    counts[key].forEach(id => out.push(itemBlock(id, false)));
  }
  out.push('');
  return out.join('\n');
}

const dialog = document.querySelector('[data-plan-dialog]');
dialog.querySelector('[data-close-dialog]').addEventListener('click', () => dialog.close());

async function copyPlan() {
  const markdown = buildMarkdown();
  try {
    await navigator.clipboard.writeText(markdown);
    showToast('Plan copied to the clipboard');
  } catch {
    dialog.querySelector('textarea').value = markdown;
    dialog.showModal();
    dialog.querySelector('textarea').select();
  }
}

function exportPlan() {
  const markdown = buildMarkdown();
  const url = URL.createObjectURL(new Blob([markdown], { type: 'text/markdown' }));
  const link = document.createElement('a');
  link.href = url;
  link.download = 'DEPS_UPGRADE_PLAN.md';
  document.body.append(link);
  link.click();
  link.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
  showToast('DEPS_UPGRADE_PLAN.md downloaded');
}

async function finishReview() {
  if (finished) return;
  const markdown = buildMarkdown();
  try {
    const response = await fetch('/api/finish', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ report_id: plan.report_id, markdown }),
    });
    if (!response.ok) throw new Error(`finish ${response.status}`);
    const result = await response.json();
    finished = true;
    document.querySelector('[data-finish]').disabled = true;
    setSaveStatus('Review finished');
    showToast(`Plan written to ${result.plan}. The review server has stopped; you can close this tab.`, true);
  } catch {
    showToast('Could not reach the review server. Use Copy plan or Export plan instead.');
  }
}

document.querySelector('[data-copy]').addEventListener('click', copyPlan);
document.querySelector('[data-export]').addEventListener('click', exportPlan);
document.querySelector('[data-finish]').addEventListener('click', finishReview);

async function restore() {
  let saved = readLocal();
  if (serverMode) {
    try {
      const remote = await readServer();
      serverAvailable = true;
      document.querySelector('[data-finish]').hidden = false;
      if (Object.keys(remote.decisions).length || !saved) saved = remote;
      setSaveStatus(`Saving to ${serverStateFile}`);
    } catch {
      setSaveStatus('Saved in this browser');
    }
  } else {
    setSaveStatus('Saved in this browser');
  }
  if (saved) state.decisions = saved.decisions;
  items.forEach(item => renderItem(item.dataset.id));
  renderProgress();
  applyFilters();
  if (serverAvailable && saved && saved !== readLocal()) writeLocal();
}

restore();

window.addEventListener('beforeprint', () => {
  document.querySelectorAll('.details').forEach(details => { details.dataset.hiddenBeforePrint = String(details.hidden); details.hidden = false; });
  document.querySelectorAll('.notes').forEach(notes => { notes.dataset.openBeforePrint = String(notes.open); notes.open = true; });
});

window.addEventListener('afterprint', () => {
  document.querySelectorAll('.details').forEach(details => { details.hidden = details.dataset.hiddenBeforePrint === 'true'; delete details.dataset.hiddenBeforePrint; });
  document.querySelectorAll('.notes').forEach(notes => { notes.open = notes.dataset.openBeforePrint === 'true'; delete notes.dataset.openBeforePrint; });
});

window.addEventListener('beforeunload', event => {
  if (serverAvailable || finished) return;
  const decided = Object.values(state.decisions).some(entry => entry.decision || entry.note.trim());
  if (!decided) return;
  event.preventDefault();
  event.returnValue = '';
});
  </script>
</body>
</html>
