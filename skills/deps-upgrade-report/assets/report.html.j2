{% macro messages(title, items, tone) -%}
{% if items %}
<section class="notice {{ tone }}">
  <h3>{{ title }}</h3>
  <ul>
    {% for item in items %}<li>{{ item }}</li>{% endfor %}
  </ul>
</section>
{% endif %}
{%- endmacro %}

{% macro locations(items) -%}
{% if items %}
  {% for location in items %}<code>{{ location.path }}:{{ location.line }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
{% else %}
  <span class="muted">No project location recorded</span>
{% endif %}
{%- endmacro %}

{% macro item(entry, fragment) -%}
<article class="item" id="{{ entry.id }}" data-id="{{ entry.id }}" data-action="{{ entry.action }}" data-surface="{{ fragment.surface }}" data-decision="" tabindex="0">
  <div class="row">
    <div class="decide" role="group" aria-label="Decision for {{ entry.name }}">
      <button type="button" class="choice upgrade" data-decide="upgrade" title="Upgrade (u)">Upgrade</button>
      <button type="button" class="choice skip" data-decide="skip" title="Skip (s)">Skip</button>
      <button type="button" class="choice defer" data-decide="defer" title="Defer (d)">Defer</button>
    </div>
    <div class="who">
      <span class="name">{{ entry.name }}</span>
      <span class="group">{{ entry.group }}</span>
    </div>
    <div class="versions">
      <span class="current">{{ entry.current }}</span>
      <span class="arrow">→</span>
      <strong class="target">{{ entry.target }}</strong>
      {% if entry.target != entry.latest %}<span class="latest">latest {{ entry.latest }}</span>{% endif %}
    </div>
    <span class="action {{ entry.action }}">{{ entry.action }}</span>
    <button type="button" class="more" aria-expanded="false" title="Details (o)">Details</button>
    <p class="summary">{{ entry.summary }}</p>
    <span class="note-flag" hidden>note</span>
  </div>
  <div class="details" hidden>
    <div class="columns">
      <div>
        <h4>What changed</h4>
        <ul>
          {% for change in entry.changes %}
          <li>{{ change }}</li>
          {% else %}
          <li class="muted">No release-note summary recorded</li>
          {% endfor %}
        </ul>
        {% if entry.changelog_url %}
        <a class="release-link" href="{{ entry.changelog_url }}" target="_blank" rel="noopener noreferrer">Release notes</a>
        {% endif %}
        <h4>Risk</h4>
        <p>{{ entry.risk }}</p>
      </div>
      <div>
        <h4>Steps</h4>
        <ol>
          {% for step in entry.steps %}
          <li>{{ step }}</li>
          {% else %}
          <li class="muted">No steps recorded</li>
          {% endfor %}
        </ol>
        <h4>Verify</h4>
        <ul>
          {% for check in entry.verify %}
          <li>{{ check }}</li>
          {% else %}
          <li class="muted">No verification recorded</li>
          {% endfor %}
        </ul>
        <p class="evidence"><strong>Evidence</strong> {{ locations(entry.locations) }}</p>
        {% if entry.current_ref is defined or entry.latest_ref is defined %}
        <p class="refs"><strong>Refs</strong> {{ entry.current_ref|default('❓ unknown') }} to {{ entry.latest_ref|default('❓ unknown') }}</p>
        {% endif %}
      </div>
    </div>
    <label class="note-field">
      <span>Note for the agent</span>
      <textarea class="note" rows="2" placeholder="Anything the executing agent should know about this one"></textarea>
    </label>
  </div>
</article>
{%- endmacro %}

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dependency upgrade plan for {{ project_name }}</title>
  <script>
const reportTheme = (() => {
  const key = 'deps-report-theme';
  const media = matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;

  function read() {
    try {
      const value = localStorage.getItem(key);
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function apply(value) {
    root.dataset.theme = value;
  }

  function save(value) {
    try {
      localStorage.setItem(key, value);
    } catch {
      return;
    }
  }

  root.classList.add('js');
  apply(read() || (media.matches ? 'dark' : 'light'));
  return { apply, media, read, save };
})();
  </script>
  <style>
:root {
  color-scheme: light;
  --ink: #172033;
  --muted: #647086;
  --paper: #f4f6fa;
  --panel: #ffffff;
  --line: #dce1ea;
  --bar: rgb(255 255 255 / 94%);
  --shadow: rgb(23 32 51 / 8%);
  --code: #eef1f6;
  --brand: #2952cc;
  --brand-soft: #e9efff;
  --danger: #a32929;
  --danger-soft: #fff0ef;
  --danger-line: #efc4c0;
  --warning: #805500;
  --warning-soft: #fff6d8;
  --warning-line: #ead797;
  --decide: #5f478f;
  --decide-soft: #f3edff;
  --decide-line: #d9c9f7;
