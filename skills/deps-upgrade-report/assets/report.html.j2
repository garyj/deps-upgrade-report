{% macro locations(items) -%}
{% if items %}
  {% for location in items %}<code>{{ location.path }}:{{ location.line }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
{% else %}
  <span class="muted">No project location recorded</span>
{% endif %}
{%- endmacro %}

{% macro item(entry) -%}
<article class="item" data-id="{{ entry.id }}" data-decision="">
  <div class="row">
    <div class="who">
      <span class="name">{{ entry.name }}</span>
      <span class="group">{{ entry.group }}</span>
    </div>
    <div class="versions">
      <span class="current">{{ entry.current }}</span>
      <span class="arrow">→</span>
      <strong class="target">{{ entry.target }}</strong>
      {% if entry.target != entry.latest %}<span class="latest">latest {{ entry.latest }}</span>{% endif %}
    </div>
    <span class="action {{ entry.action }}">{{ entry.action }}</span>
    {% if entry.changelog_url %}
    <a class="release-link" href="{{ entry.changelog_url }}" target="_blank" rel="noopener noreferrer">Release notes ↗</a>
    {% else %}
    <span class="release-link muted">No release notes</span>
    {% endif %}
    <div class="choices server-only" role="group" aria-label="Decision for {{ entry.name }}" hidden>
      <button type="button" class="choice upgrade" data-decide="upgrade">Upgrade</button>
      <button type="button" class="choice skip" data-decide="skip">Skip</button>
      <button type="button" class="choice defer" data-decide="defer">Defer</button>
    </div>
    <p class="summary">{{ entry.summary }}</p>
  </div>
  <details class="details">
    <summary>Changes, steps and evidence</summary>
    <div class="columns">
      <div>
        <h4>What changed</h4>
        <ul>
          {% for change in entry.changes %}
          <li>{{ change }}</li>
          {% else %}
          <li class="muted">No release-note summary recorded</li>
          {% endfor %}
        </ul>
        <h4>Risk</h4>
        <p>{{ entry.risk }}</p>
      </div>
      <div>
        <h4>Steps</h4>
        <ol>
          {% for step in entry.steps %}
          <li>{{ step }}</li>
          {% else %}
          <li class="muted">No steps recorded</li>
          {% endfor %}
        </ol>
        <h4>Verify</h4>
        <ul>
          {% for check in entry.verify %}
          <li>{{ check }}</li>
          {% else %}
          <li class="muted">No verification recorded</li>
          {% endfor %}
        </ul>
        <p class="evidence"><strong>Evidence</strong> {{ locations(entry.locations) }}</p>
        {% if entry.current_ref is defined or entry.latest_ref is defined %}
        <p class="refs"><strong>Refs</strong> {{ entry.current_ref|default('❓ unknown') }} to {{ entry.latest_ref|default('❓ unknown') }}</p>
        {% endif %}
      </div>
    </div>
    <label class="note-field server-only" hidden>
      <span>Note for the agent</span>
      <textarea class="note" rows="2" placeholder="Anything the executing agent should know about this one"></textarea>
    </label>
  </details>
</article>
{%- endmacro %}

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dependency upgrade plan for {{ project_name }}</title>
  <script>
const reportTheme = (() => {
  const key = 'deps-report-theme';
  const media = matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;

  function read() {
    try {
      const value = localStorage.getItem(key);
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function apply(value) {
    root.dataset.theme = value;
  }

  function save(value) {
    try {
      localStorage.setItem(key, value);
    } catch {
      return;
    }
  }

  apply(read() || (media.matches ? 'dark' : 'light'));
  return { apply, media, read, save };
})();
  </script>
  <style>
:root {
  color-scheme: light;
  --ink: #172033;
  --muted: #647086;
  --paper: #f4f6fa;
  --panel: #ffffff;
  --line: #dce1ea;
  --bar: rgb(255 255 255 / 94%);
  --shadow: rgb(23 32 51 / 8%);
  --code: #eef1f6;
  --brand: #2952cc;
  --brand-soft: #e9efff;
  --danger: #a32929;
  --danger-soft: #fff0ef;
  --danger-line: #efc4c0;
  --warning: #805500;
  --warning-soft: #fff6d8;
  --warning-line: #ead797;
  --decide: #5f478f;
  --decide-soft: #f3edff;
  --safe: #176b45;
  --safe-soft: #e8f7ef;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); }
.notice li, .summary, .section-lead, .details, .notes li, .subtitle { overflow-wrap: anywhere; }
button, summary, textarea { font: inherit; }
[hidden] { display: none !important; }
.shell { width: min(1180px, calc(100% - 32px)); margin: 0 auto; }
header { padding: 40px 0 22px; }
.header-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.eyebrow { margin: 0; color: var(--brand); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
h1 { margin: 6px 0 0; font-size: clamp(2rem, 5vw, 3.2rem); letter-spacing: -0.045em; }
.subtitle { margin: 10px 0 0; color: var(--muted); }
.button { display: inline-flex; align-items: center; padding: 8px 12px; border: 1px solid var(--line); border-radius: 9px; background: var(--panel); color: var(--ink); cursor: pointer; font-weight: 750; }
.button:hover { border-color: var(--brand); color: var(--brand); }
.button:focus-visible, .choice:focus-visible { outline: 3px solid var(--brand-soft); outline-offset: 2px; }
.button.primary { background: var(--ink); border-color: var(--ink); color: var(--panel); }
.button.primary:hover { background: var(--brand); border-color: var(--brand); color: white; }
.bar { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; background: var(--bar); box-shadow: 0 12px 32px var(--shadow); backdrop-filter: blur(12px); }
.bar .progress { font-weight: 800; }
.bar .status { flex: 1; color: var(--muted); font-size: 0.84rem; }
main { padding: 22px 0 60px; }
h2 { margin: 34px 0 6px; font-size: 1.5rem; letter-spacing: -0.03em; }
h2 .tag { margin-left: 8px; color: var(--muted); font-size: 0.85rem; font-weight: 700; letter-spacing: 0; vertical-align: middle; }
.section-lead { margin: 0 0 14px; color: var(--muted); }
.notice, .empty { margin: 14px 0; padding: 17px 19px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
.notice h3 { margin: 0 0 8px; font-size: 1rem; }
.notice ul { margin: 0; padding-left: 20px; }
.notice li { line-height: 1.5; }
.notice .tag { color: var(--muted); font-size: 0.8rem; font-weight: 700; margin-right: 6px; }
.notice.error { border-color: var(--danger-line); background: var(--danger-soft); }
.notice.warning { border-color: var(--warning-line); background: var(--warning-soft); }
.empty { display: flex; gap: 10px; color: var(--safe); }
.item { margin: 10px 0; border: 1px solid var(--line); border-radius: 13px; background: var(--panel); }
.item[data-decision="upgrade"] { border-left: 5px solid var(--safe); }
.item[data-decision="skip"] { border-left: 5px solid var(--muted); opacity: 0.72; }
.item[data-decision="defer"] { border-left: 5px solid var(--warning); }
.row { display: grid; grid-template-columns: minmax(160px, 1.3fr) minmax(170px, 1fr) auto auto auto; grid-template-areas: "who versions action link choices" "summary summary summary summary summary"; gap: 4px 16px; align-items: center; padding: 14px 18px 6px; }
.who { grid-area: who; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.name { font-weight: 800; font-size: 1.02rem; }
.group { color: var(--muted); font-size: 0.84rem; }
.versions { grid-area: versions; color: var(--muted); font-variant-numeric: tabular-nums; }
.versions .target { color: var(--ink); }
.versions .latest { margin-left: 6px; font-size: 0.8rem; }
.action { grid-area: action; justify-self: start; padding: 5px 9px; border-radius: 999px; font-size: 0.72rem; font-weight: 850; text-transform: uppercase; }
.action.migrate { background: var(--danger-soft); color: var(--danger); }
.action.hold { background: var(--warning-soft); color: var(--warning); }
.action.decide { background: var(--decide-soft); color: var(--decide); }
.action.upgrade { background: var(--safe-soft); color: var(--safe); }
.release-link { grid-area: link; color: var(--brand); font-size: 0.9rem; font-weight: 750; white-space: nowrap; }
.release-link.muted { color: var(--muted); font-weight: 600; }
.choices { grid-area: choices; display: inline-flex; border: 1px solid var(--line); border-radius: 9px; overflow: hidden; }
.choice { padding: 7px 11px; border: 0; border-right: 1px solid var(--line); background: var(--panel); color: var(--muted); cursor: pointer; font-size: 0.82rem; font-weight: 800; }
.choice:last-child { border-right: 0; }
.choice:hover { color: var(--ink); background: var(--code); }
.choice.upgrade.active { background: var(--safe); color: white; }
.choice.skip.active { background: var(--muted); color: white; }
.choice.defer.active { background: var(--warning); color: white; }
.summary { grid-area: summary; margin: 2px 0 0; line-height: 1.5; }
.details { padding: 0 18px 12px; }
.details > summary { width: fit-content; color: var(--muted); cursor: pointer; font-size: 0.84rem; font-weight: 750; }
.details > summary:hover { color: var(--brand); }
.details[open] > summary { margin-bottom: 4px; }
.columns { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; border-top: 1px solid var(--line); }
.details h4 { margin: 18px 0 6px; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
.details p, .details li { line-height: 1.55; margin: 4px 0; }
.details ul, .details ol { margin: 0; padding-left: 20px; }
code { padding: 2px 5px; border-radius: 5px; background: var(--code); font-size: 0.84em; }
.note-field { display: block; margin-top: 18px; }
.note-field span { display: block; margin-bottom: 6px; font-size: 0.82rem; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
.note { width: 100%; padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; background: var(--paper); color: var(--ink); resize: vertical; }
.note:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
.notes { margin: 14px 0; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
.notes summary { padding: 14px 18px; cursor: pointer; font-weight: 750; }
.notes ul { margin: 0; padding: 0 18px 16px 38px; }
.notes li { line-height: 1.5; margin: 4px 0; color: var(--muted); font-size: 0.92rem; }
.muted, footer { color: var(--muted); }
footer { padding: 0 0 40px; font-size: 0.84rem; }
@media screen {
  :root[data-theme="dark"] {
    color-scheme: dark;
    --ink: #e7edf8;
    --muted: #a7b1c4;
    --paper: #0e1422;
    --panel: #171f30;
    --line: #34405a;
    --bar: rgb(23 31 48 / 94%);
    --shadow: rgb(0 0 0 / 25%);
    --code: #232d42;
    --brand: #93adff;
    --brand-soft: #24345e;
    --danger: #ffaaa3;
    --danger-soft: #3b2025;
    --danger-line: #744047;
    --warning: #ffd576;
    --warning-soft: #3a2f17;
    --warning-line: #6f5b2d;
    --decide: #d1bbff;
    --decide-soft: #2f2546;
    --safe: #86d9af;
    --safe-soft: #17382a;
  }
  :root[data-theme="dark"] .choice.upgrade.active, :root[data-theme="dark"] .choice.defer.active { color: #0e1422; }
}
@media (max-width: 820px) {
  .shell { width: min(100% - 20px, 1180px); }
  header { padding-top: 26px; }
  .row { grid-template-columns: 1fr auto; grid-template-areas: "who action" "versions link" "summary summary" "choices choices"; }
  .choices { justify-self: start; margin-top: 6px; }
  .columns { grid-template-columns: 1fr; gap: 0; }
}
@media print {
  body { background: white; }
  .shell { width: 100%; }
  .bar, .button, .server-only, footer { display: none !important; }
  .item { break-inside: avoid; opacity: 1; }
  a { color: inherit; }
}
  </style>
</head>
<body>
  <header class="shell">
    <div class="header-top">
      <p class="eyebrow">Dependency upgrade plan</p>
      <button class="button" type="button" data-theme-toggle>Toggle theme</button>
    </div>
    <h1>{{ project_name }}</h1>
    <p class="subtitle">Generated {{ generated }} from {{ project_root }}. {{ overview.outdated }} outdated: {{ overview.decide }} decide, {{ overview.migrate }} migrate, {{ overview.hold }} hold, {{ overview.upgrade }} upgrade.</p>
  </header>
  <main class="shell">
    <div class="bar server-only" hidden>
      <span class="progress"><b data-decided>0</b> of {{ overview.outdated }} decided</span>
      <span class="status" data-status></span>
      <button class="button primary" type="button" data-finish>Finish review</button>
    </div>

    {% set blockers = [] %}
    {% for fragment in fragments %}{% for blocker in fragment.blockers %}{% set _ = blockers.append((fragment.label, blocker)) %}{% endfor %}{% endfor %}
    {% set errors = [] %}
    {% for fragment in fragments %}{% for error in fragment.errors %}{% set _ = errors.append((fragment.label, error)) %}{% endfor %}{% endfor %}
    {% if errors %}
    <section class="notice error">
      <h3>Incomplete research</h3>
      <ul>{% for label, error in errors %}<li><span class="tag">{{ label }}</span>{{ error }}</li>{% endfor %}</ul>
    </section>
    {% endif %}
    {% if blockers %}
    <section class="notice warning">
      <h3>Check before you start</h3>
      <ul>{% for label, blocker in blockers %}<li><span class="tag">{{ label }}</span>{{ blocker }}</li>{% endfor %}</ul>
    </section>
    {% endif %}

    {% set batch_number = namespace(value=0) %}
    {% for fragment in fragments %}
      {% for batch in fragment.batches %}
      {% set batch_number.value = batch_number.value + 1 %}
      <section>
        <h2>Batch {{ batch_number.value }}: {{ batch.name }}<span class="tag">{{ fragment.label }}</span></h2>
        <p class="section-lead">{{ batch.reason }}</p>
        {% for entry in batch.entries %}{{ item(entry) }}{% endfor %}
      </section>
      {% endfor %}
    {% endfor %}

    {% for fragment in fragments %}
    <section>
      <h2>{{ fragment.label }}<span class="tag">{{ fragment.manager }} · {{ fragment.remaining|length }} of {{ fragment.entries|length }} outside batches</span></h2>
      {% for entry in fragment.remaining %}
        {{ item(entry) }}
      {% else %}
        {% if not fragment.entries and not fragment.errors %}
        <div class="empty"><strong>Current</strong><span>No outdated direct dependencies found.</span></div>
        {% elif fragment.entries %}
        <p class="section-lead">Every {{ fragment.label }} entry belongs to a batch above.</p>
        {% endif %}
      {% endfor %}
    </section>
    {% endfor %}

    {% for fragment in fragments if fragment.notes %}
    <details class="notes">
      <summary>{{ fragment.label }} research notes ({{ fragment.notes|length }})</summary>
      <ul>{% for note in fragment.notes %}<li>{{ note }}</li>{% endfor %}</ul>
    </details>
    {% endfor %}
  </main>
  <footer class="shell">Read-only report. No manifests, lockfiles, dependencies, or workflows were changed.</footer>
  <script id="plan-data" type="application/json">{{ plan|tojson }}</script>
  <script>
const themeToggle = document.querySelector('[data-theme-toggle]');
function syncThemeToggle() {
  const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  themeToggle.textContent = `${nextTheme[0].toUpperCase()}${nextTheme.slice(1)} mode`;
}
themeToggle.addEventListener('click', () => {
  const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  reportTheme.apply(nextTheme);
  reportTheme.save(nextTheme);
  syncThemeToggle();
});
reportTheme.media.addEventListener('change', event => {
  if (reportTheme.read() !== null) return;
  reportTheme.apply(event.matches ? 'dark' : 'light');
  syncThemeToggle();
});
syncThemeToggle();

window.addEventListener('beforeprint', () => {
  document.querySelectorAll('details').forEach(details => { details.open = true; });
});

const items = [...document.querySelectorAll('.item')];
const status = document.querySelector('[data-status]');
let decisions = {};
let saving = Promise.resolve();

function decisionOf(id) {
  return decisions[id] || { decision: '', note: '' };
}

function render() {
  for (const item of items) {
    const { decision, note } = decisionOf(item.dataset.id);
    item.dataset.decision = decision;
    item.querySelectorAll('.choice').forEach(button => {
      button.classList.toggle('active', button.dataset.decide === decision);
      button.setAttribute('aria-pressed', String(button.dataset.decide === decision));
    });
    item.querySelector('.note').value = note;
  }
  document.querySelector('[data-decided]').textContent = items.filter(item => item.dataset.decision).length;
}

function update(id, change) {
  decisions[id] = { ...decisionOf(id), ...change };
  render();
  const body = JSON.stringify(decisions);
  saving = saving
    .then(() => fetch('/api/state', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body }))
    .then(response => { status.textContent = response.ok ? 'Saved' : `Not saved: ${response.status}`; })
    .catch(() => { status.textContent = 'Not saved: the review server has stopped'; });
}

for (const item of items) {
  const id = item.dataset.id;
  item.querySelectorAll('.choice').forEach(button => button.addEventListener('click', () => {
    update(id, { decision: decisionOf(id).decision === button.dataset.decide ? '' : button.dataset.decide });
  }));
  item.querySelector('.note').addEventListener('change', event => update(id, { note: event.target.value }));
}

document.querySelector('[data-finish]').addEventListener('click', async event => {
  await saving;
  try {
    const response = await fetch('/api/finish', { method: 'POST' });
    if (!response.ok) throw new Error(String(response.status));
    const result = await response.json();
    event.target.disabled = true;
    status.textContent = `Plan written to ${result.plan}. The review server has stopped; you can close this tab.`;
  } catch {
    status.textContent = 'Could not reach the review server.';
  }
});

async function connect() {
  if (location.protocol !== 'http:') return;
  const response = await fetch('/api/state', { cache: 'no-store' });
  if (!response.ok) return;
  const state = await response.json();
  decisions = state.decisions;
  status.textContent = `Saving to ${state.state_file}`;
  document.querySelectorAll('.server-only').forEach(node => { node.hidden = false; });
  render();
}

connect().catch(() => {});
  </script>
</body>
</html>
